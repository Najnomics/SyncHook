# ============================================================================
# SyncHook Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================================

# ============================================================================
# NETWORK CONFIGURATION
# ============================================================================

# Ethereum Mainnet
MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
MAINNET_CHAIN_ID=1

# Ethereum Testnets
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
SEPOLIA_CHAIN_ID=11155111

# Layer 2 Networks
ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
ARBITRUM_CHAIN_ID=42161

POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
POLYGON_CHAIN_ID=137

BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
BASE_CHAIN_ID=8453

# ============================================================================
# PRIVATE KEYS AND WALLETS
# ============================================================================

# Deployment wallet private key (NEVER commit real private keys!)
PRIVATE_KEY=0x1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef

# Testnet deployment key
TESTNET_PRIVATE_KEY=0x1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef

# Mainnet deployment key
MAINNET_PRIVATE_KEY=0x1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef

# ============================================================================
# EIGENLAYER CONFIGURATION
# ============================================================================

# EigenLayer contract addresses
EIGENLAYER_DELEGATION_MANAGER=0x39053D9618C4E5c5Fc4Ad8eA723d85815C4aBf92
EIGENLAYER_STRATEGY_MANAGER=0x858646372CC42E1A6275C0bA6e8d37e7d82d13b7

# AVS Configuration
AVS_NAME=SyncHook
AVS_DESCRIPTION=Cross-chain liquidity synchronization service
AVS_METADATA_URI=https://api.synchook.io/metadata

# ============================================================================
# ACROSS PROTOCOL CONFIGURATION
# ============================================================================

# Across Protocol contract addresses
ACROSS_SPOKE_POOL_ETHEREUM=0x4D9079Bb4165aeb4084C526a32695dCfd2F77381
ACROSS_SPOKE_POOL_ARBITRUM=0x4D9079Bb4165aeb4084C526a32695dCfd2F77381

# ============================================================================
# MONITORING AND ALERTS
# ============================================================================

# Discord webhook for notifications
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# PostgreSQL configuration
DATABASE_URL=postgresql://username:password@localhost:5432/synchook

# ============================================================================
# API CONFIGURATION
# ============================================================================

# API configuration
API_PORT=8080
API_BASE_URL=https://api.synchook.io

# ============================================================================
# SECURITY CONFIGURATION
# ============================================================================

# JWT secret for API authentication
JWT_SECRET=your-super-secret-jwt-key-here

# ============================================================================
# NOTICE
# ============================================================================
# 
# IMPORTANT SECURITY NOTES:
# 1. Never commit real private keys to version control
# 2. Use environment-specific .env files
# 3. Rotate keys regularly
# 4. Use hardware wallets for production deployments
#
# ============================================================================

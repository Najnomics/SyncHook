# SyncHook Production Environment Configuration

# Database Configuration
DATABASE_NAME=synchook
DATABASE_USER=synchook
DATABASE_PASSWORD=your_secure_database_password_here

# Redis Configuration
REDIS_PASSWORD=your_secure_redis_password_here

# Blockchain Private Keys (KEEP SECURE!)
ETHEREUM_PRIVATE_KEY=your_ethereum_private_key_here
ARBITRUM_PRIVATE_KEY=your_arbitrum_private_key_here
OPTIMISM_PRIVATE_KEY=your_optimism_private_key_here

# Logging Configuration
LOG_LEVEL=info

# Monitoring Configuration
GRAFANA_PASSWORD=your_grafana_admin_password_here

# SSL Configuration (for production)
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# Security Configuration
JWT_SECRET=your_jwt_secret_here
ENCRYPTION_KEY=your_encryption_key_here

# External API Keys
INFURA_API_KEY=your_infura_api_key_here
ALCHEMY_API_KEY=your_alchemy_api_key_here

# EigenLayer Configuration
EIGENLAYER_OPERATOR_ID=1
EIGENLAYER_QUORUM_NUMBER=0

# Across Protocol Configuration
ACROSS_RELAYER_FEE_PCT=0.001
ACROSS_MAX_GAS_PRICE=20000000000

# Rate Limiting
MAX_ACTIONS_PER_HOUR=10
ACTION_COOLDOWN_SECONDS=60

# Emergency Controls
EMERGENCY_MODE=false
MAX_REBALANCE_AMOUNT=1000000000000000000000
MAX_DAILY_REBALANCE=10000000000000000000000

# Monitoring
PROMETHEUS_RETENTION_DAYS=30
GRAFANA_ANONYMOUS_ACCESS=false
